rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Rol guardado en users/{uid}.role (p. ej. "admin", "editor", "reader")
    function hasRole(role) {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || hasRole('admin');
      // El usuario crea su perfil sin rol; el rol solo lo asigna un admin
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(
             ['displayName', 'email', 'photoURL', 'createdAt', 'lastLoginAt'])
        && request.resource.data.createdAt == request.time;
      allow update: if hasRole('admin')
        || (isOwner(uid)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['displayName', 'photoURL', 'lastLoginAt']));
      allow delete: if hasRole('admin');

      // Biblioteca personal: solo el dueño
      match /books/{bookId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validBook(request.resource.data);
      }

      // Sesiones de lectura: se crean y no se editan
      match /sessions/{sessionId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && validSession(request.resource.data);
      }

      // Ánimo diario; el ID es la fecha yyyy-mm-dd
      match /moods/{date} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && validMood(request.resource.data, date);
      }
    }

    function validBook(b) {
      return b.keys().hasOnly(['title', 'authors', 'coverUrl', 'pageCount', 'googleId',
                               'description', 'status', 'currentPage', 'rating', 'notes',
                               'startedAt', 'finishedAt', 'createdAt', 'updatedAt'])
        && b.title is string && b.title.size() > 0 && b.title.size() <= 300
        && b.authors is list && b.authors.size() <= 20
        && b.status in ['want', 'reading', 'read']
        && b.currentPage is int && b.currentPage >= 0
        && (b.pageCount == null || (b.pageCount is int && b.pageCount > 0))
        && (b.rating == null || (b.rating is int && b.rating >= 1 && b.rating <= 5))
        && b.notes is string && b.notes.size() <= 20000;
    }

    function validSession(s) {
      return s.keys().hasOnly(['bookId', 'bookTitle', 'startedAt', 'durationMin', 'pagesRead',
                               'ambience', 'moodBefore', 'moodAfter'])
        && s.startedAt is timestamp
        && s.durationMin is number && s.durationMin >= 0 && s.durationMin <= 1440
        && s.ambience is list && s.ambience.size() <= 10
        && (s.moodBefore == null || (s.moodBefore is int && s.moodBefore >= 1 && s.moodBefore <= 5))
        && (s.moodAfter == null || (s.moodAfter is int && s.moodAfter >= 1 && s.moodAfter <= 5));
    }

    function validMood(m, date) {
      return m.keys().hasOnly(['date', 'mood', 'note', 'updatedAt'])
        && m.date == date
        && m.mood is int && m.mood >= 1 && m.mood <= 5
        && m.note is string && m.note.size() <= 2000;
    }

    // Denegar todo lo demás por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
